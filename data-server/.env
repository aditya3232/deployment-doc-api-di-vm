## this config for docker-compose.yml only

# service name
DOC_API_SERVICE_1_NAME=doc-api-service-1
DOC_API_SERVICE_2_NAME=doc-api-service-2

# app configuration
APP_ENV=production
LOG_LEVEL=info
WEB_PREFORK=false
JWT_SECRET=super-secret-key
JWT_ISSUER=doc-api-service

# port mapping configuration
DOC_API_SERVICE_1_CONT_PORT=4040
DOC_API_SERVICE_2_CONT_PORT=4041
DATABASE_HOST_PORT=4042 #change
DATABASE_CONT_PORT=5432
REDIS_HOST_PORT=4043 #change
REDIS_CONT_PORT=6379
MINIO_DASH_HOST_PORT=4046 #change
MINIO_DASH_CONT_PORT=4046 #change
MINIO_HOST_PORT=4044 #change
MINIO_CONT_PORT=9000
HA_PROXY_DASH_HOST_PORT=8404
HA_PROXY_DASH_CONT_PORT=8404
HA_PROXY_HOST_PORT=8080
HA_PROXY_CONT_PORT=80

# postgres configuration
DOC_API_SERVICE_DB=doc_api_service
DATABASE_USER=root
DATABASE_PASSWORD=root_password
DATABASE_MAX_OPEN_CONNECTION=25
DATABASE_MAX_IDLE_CONNECTION=10

# minio configuration
DOC_API_SERVICE_MINIO_BUCKET=doc-api-service
MINIO_PUBLIC_URL=0.0.0.0
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false

# redis configuration
REDIS_PASSWORD=password
